<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lease Tree View -->
    <record id="leses_view_tree" model="ir.ui.view">
        <field name="name">lease.tree</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="state"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
            </tree>
        </field>
    </record>

    <!-- Lease Form View -->
    <record id="lease_view_form" model="ir.ui.view">
        <field name="name">lease.form</field>
        <field name="model">real_estate.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                    <button name="action_create_electricity_bill" string="Create Electricity Bill" type="object" class="oe_highlight"/>
                    <button name="action_set_active" string="Set Active" invisible="state == 'active'" type="object" class="oe_highlight"/>
                    <button name="%(real_estate.action_maintenance_request_wizard)d" string="Maintenance Request" type="action" context="{'default_lease_id': active_id, 'default_electricity_bill_date': start_date}" invisible="state != 'active'"/>
                    <button name="set_back_to_draft" string="Set Draft" invisible="state == 'draft'" type="object"/>
                    <button name="action_set_at_risk" string="Set At Risk" invisible="state == 'at_risk'" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,at_risk,expired,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Lease Information">
                            <field name="property_id"/>
                            <field name="tenant_id"/>
                            <field name="state"/>
                        </group>
                        <group string="Financial Details">
                            <field name="monthly_rent"/>
                            <field name="total_cost" decoration-danger="1"/>
                            <field name="plumbing_cost"/>
                            <field name="electrical_cost"/>
                            <field name="air_condition_cost"/>
                            <field name="appliance_cost"/>
                            <field name="other_cost"/>
                            <field name="deposit_paid"/>
                        </group>
                        <group string="Lease Details">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="electricity_bill_ids"/>
                            <field name="duration_months"/>
                            <field name="is_active"/>
                            <field name= "tenant_age"/>
                        </group>
                    </group>
                
                <notebook>
                    <page string="Notes">
                        <field name="notes"/>
                    </page>
                    <page string="Maintenance Requests">
                            <field name="maintenance_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="issue_type"/>
                                    <field name="urgency"/>
                                    <field name="create_date"/>
                                </tree>
                            </field>                                
                        </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lease Action -->
    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease info
            </p>
        </field>
    </record>
</odoo>
