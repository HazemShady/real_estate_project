<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- maintenanceList View (Tree) -->
    <record id="view_maintenance_tree" model="ir.ui.view">
        <field name="name">real_estate.maintenance.tree</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <tree string="maintenances">
                <field name="name"/>
                <field name="lease_id" required="1"/>
                <field name="property_id"/>
                <field name="assigned_to"/>
                <field name="issue_type"/>
                <field name="urgency"/>
                <field name="preferred_date"/>
                <field name="scheduled_date"/>
                <field name="electricity_bill_date"/>
            </tree>
        </field>
    </record>
        <!-- maintenance Form View -->
    <record id="view_maintenance_form" model="ir.ui.view">
        <field name="name">real_estate.maintenance.form</field>
        <field name="model">maintenance.request</field>
        <field name="arch" type="xml">
            <form string="maintenance">
                <header>
                    <button name="action_set_in_progress" string="Start Work" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_set_done" string="Mark Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_set_cancelled" string="Cancel" type="object" invisible="state in ['done', 'cancelled']"/>
                    <button name="action_reset_to_submitted" string="Reopen" type="object" invisible="state not in ['done', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,in_progress,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Maintenance Name"/>
                        </h1>
                    </div>
                    <group string="Maintenance Details">
                        <group>
                            <field name="lease_id"/>
                            <field name="assigned_to"/>
                            <field name="actual_cost"/>
                            <field name="completion_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Maintenance Information">
                        <group>
                            <field name="property_id"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="issue_type"/>
                            <field name="urgency"/>
                            <field name="preferred_date"/>
                            <field name="scheduled_date"/>
                            <field name="electricity_bill_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- maintenance Action (Links views together) -->
    <record id="action_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Maintenance Request
            </p>
            
            
        </field>
    </record>
    <record id="ir_cron_auto_send_email_reminder_main" model="ir.cron">
        <field name="name">Real Estate: Auto Send Email Reminder Maintenance</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_send_email_reminder_main()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
