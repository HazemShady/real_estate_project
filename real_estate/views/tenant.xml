<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
    Tenant List View (Tree)
    ============================================================ -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
    Tenant Form View
    ============================================================ -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="action_toggle_active" string="Toggle Active" type="object" class="oe_highlight"/>
                    <field name="active" widget="boolean_button" options="{'terminology': 'active'}" invisible="1"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tenant Name" size="40"/>
                        </h1>
                    </div>

                    <group string="Contact Information">
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="mobile"/>
                            <field name="city"/>
                        </group>
                    </group>

                    <group string="Personal Details">
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age_category"/>
                        </group>
                        <group>
                            <field name="date_joined" readonly="1"/>
                            <field name="crm_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="property_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                    <field name="monthly_rent"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
    Tenant Search View
    ============================================================ -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="age_category"/>
                <field name="crm_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Has Mobile" name="has_mobile" domain="[('mobile', '!=', False)]"/>
                <filter string="Has CRM Lead" name="has_crm" domain="[('crm_id', '!=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                    <filter string="Date Joined" name="group_by_date_joined" context="{'group_by': 'date_joined'}"/>
                    <filter string="Age Category" name="group_by_age_category" context="{'group_by': 'age_category'}"/>
                    <filter string="CRM Lead" name="group_by_crm" context="{'group_by': 'crm_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
    Tenant Kanban View
    ============================================================ -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    <field name="mobile"/>
                                </div>
                                <div class="text-muted mt-1">
                                    <field name="city"/>
                                </div>
                                <div class="text-muted mt-1">
                                    <t t-if="record.active.raw_value">
                                        <span class="badge bg-success">Active</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-secondary">Inactive</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
    Tenant Action
    ============================================================ -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tenant
            </p>
        </field>
    </record>
</odoo>