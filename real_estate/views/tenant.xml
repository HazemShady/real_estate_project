<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tenant List View (Tree) -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
            </tree>
        </field>
    </record>

    <!-- Tenant Form View -->
    <record id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>
                    <button name="update_notes" string="Update Notes" type="object" class="oe_highlight"/>
                    <button name="update_CRM_Notes" string="Update CRM Notes" type="object" class="oe_highlight"/>
                    <button name="update_Website_Notes" string="Update Website Notes" type="object" class="oe_highlight"/>
                </header>

                <sheet>
                    <h1>
                        <field name="name" placeholder="Tenant Name" size="40" string="Tenant Name" label="Name"/>
                    </h1>

                    <group string="Tenant Information">
                        <group>
                            <field name="email"/>
                            <field name="mobile"/>
                            <field name="city"/>
                            <field name="age_category"/>
                        </group>

                        <group string="Additional Information">
                            <field name="date_joined"/>
                            <field name="active"/>
                            <field name="crm_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                    
                        <page name="info" string="Info">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </tree>
                            </field>                                
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tenant Search View -->
    <record id="view_tenant_search" model="ir.ui.view">
        <field name="name">real_estate.tenant.search</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <search string="Search Tenants">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="city"/>
                <field name="date_joined"/>
                <field name="age_category"/>
                <field name="crm_id"/>
                <field name="website_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Has Mobile" name="has_mobile" domain="[('mobile', '!=', False)]"/>
                <filter string="Has CRM Lead" name="has_crm" domain="[('crm_id', '!=', False)]"/>
                <filter string="Has Website" name="has_website" domain="[('website_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                    <filter string="Date Joined" name="group_by_date_joined" context="{'group_by': 'date_joined'}"/>
                    <filter string="Age Category" name="group_by_age_category" context="{'group_by': 'age_category'}"/>
                    <filter string="CRM Lead" name="group_by_crm" context="{'group_by': 'crm_id'}"/>
                    <filter string="Website" name="group_by_website" context="{'group_by': 'website_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="date_joined"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Joined: <field name="date_joined"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tenant action -->
    <record id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>
