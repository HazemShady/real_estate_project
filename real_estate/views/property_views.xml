<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
    Property List View (Tree)
    ============================================================ -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties">
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="available"/>
                <field name="agent_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- ============================================================
    Property Search View
    ============================================================ -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="property_type"/>
                <field name="agent_id"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <separator/>
                <filter string="Available" name="available" domain="[('available', '=', True)]"/>
                <filter string="Unavailable" name="unavailable" domain="[('available', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type" context="{'group_by': 'property_type'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'available'}"/>
                    <filter string="Agent" name="group_by_agent" context="{'group_by': 'agent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
    Property Form View
    ============================================================ -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="%(action_real_estate_lease_wizard)d"
                            string="Create Lease"
                            type="action"
                            context="{'default_property_id': active_id}"
                            class="oe_highlight"/>
                     <button name="action_toggle_availability"
                             string="Toggle Availability"
                             type="object"
                             class="oe_highlight"/>
                 </header>

                <sheet>
                    <field name="property_image" widget="image" class="oe_right oe_avatar" options="{'size': [120, 120]}"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_leases" type="object" icon="fa-home" invisible="not lease_ids">
                            <field name="lease_ids" widget="statinfo" string="Leases"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>

                    <group string="Property Details">
                        <group>
                            <field name="property_type"/>
                            <field name="available"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="deposit" string="Deposit Amount"/>
                            <field name="agent_id"/>
                        </group>
                    </group>

                    <group string="Additional Information">
                        <group>
                            <field name="bedrooms"/>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Property description..."/>
                        </page>
                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="tenant_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state"/>
                                    <field name="monthly_rent"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
    Property Kanban View
    ============================================================ -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="property_type"/>
                <field name="price"/>
                <field name="bedrooms"/>
                <field name="available"/>
                <field name="property_image"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="mt-1">
                                    <span class="badge bg-secondary"><field name="property_type"/></span>
                                </div>
                                <div class="mt-1 fw-bold text-primary">
                                     Rent: <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="text-muted mt-1">
                                    Bedrooms: <field name="bedrooms"/> | 
                                    <t t-if="record.available.raw_value">
                                        <span class="badge bg-success">Available</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge bg-danger">Unavailable</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================
    Property Action (Links views together)
    ============================================================ -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
</odoo>