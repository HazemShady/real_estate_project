<odoo>
    <record id="property_category" model="ir.module.category">
        <field name="name">Real Estate</field>
    </record>
    <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="property_category"/>
    </record>

    <record id="group_lease_manager" model="res.groups">
        <field name="name">Lease Manager</field>
        <field name="category_id" ref="property_category"/>
        <field name="implied_ids" eval="[(4, ref('real_estate.group_property_manager'))]"/>
    </record>
    <record id="group_maintenance" model="res.groups">
        <field name="name">Maintenance User</field>
        <field name="category_id" ref="property_category"/>
    </record>

    <record id="group_maintenance_request" model="res.groups">
        <field name="name">Maintenance Administrator</field>
        <field name="category_id" ref="property_category"/>
        <field name="implied_ids" eval="[(4, ref('real_estate.group_maintenance'))]"/>
    </record>

    <!-- Maintenance users can only work with requests they created. -->
    <record id="rule_maintenance_request_user_own" model="ir.rule">
        <field name="name">Maintenance Request: Own Requests Only</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="groups" eval="[(4, ref('real_estate.group_maintenance'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Administrators inherit the user role but may access every request. -->
    <record id="rule_maintenance_request_administrator_all" model="ir.rule">
        <field name="name">Maintenance Request: All Requests</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="groups" eval="[(4, ref('real_estate.group_maintenance_request'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
