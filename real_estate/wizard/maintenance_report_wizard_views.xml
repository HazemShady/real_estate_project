<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_report_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.report.wizard.form</field>
        <field name="model">maintenance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Maintenance Report">
                <group>
                    <group string="Request Filters">
                        <field name="property_id"/>
                        <field name="tenant_id"/>
                        <field name="issue_type"/>
                        <field name="urgency"/>
                    </group>
                    <group string="Actual Cost Range">
                        <field name="filter_actual_cost"/>
                        <field name="actual_cost_from" invisible="not filter_actual_cost"/>
                        <field name="actual_cost_to" invisible="not filter_actual_cost"/>
                    </group>
                </group>
                <group invisible="not excel_file">
                    <field name="excel_file" filename="excel_filename" readonly="1"/>
                    <field name="excel_filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Generate Report"
                            name="action_generate_report"
                            type="object"
                            class="btn-primary"
                            invisible="excel_file != False"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_report_wizard" model="ir.actions.act_window">
        <field name="name">Maintenance Report</field>
        <field name="res_model">maintenance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_maintenance_report"
              name="Maintenance Report"
              parent="menu_real_estate_reports"
              action="action_maintenance_report_wizard"
              groups="real_estate.group_maintenance,real_estate.group_maintenance_request"
              sequence="20"/>
</odoo>
